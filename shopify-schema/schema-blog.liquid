{%- comment -%}
  Blog + ItemList for a blog index page. Render on templates/blog.liquid.
  Lists the posts on the CURRENT paginated page only.
{%- endcomment -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Blog",
  "@id": {{ blog.url | prepend: shop.url | append: '#blog' | json }},
  "url": {{ blog.url | prepend: shop.url | json }},
  "name": {{ blog.title | json }},
  "publisher": { "@id": {{ shop.url | append: '/#organization' | json }} },
  "blogPost": [
    {%- for article in blog.articles limit: 20 -%}
      {%- unless forloop.first %},{% endunless %}
      {
        "@type": "BlogPosting",
        "@id": {{ article.url | prepend: shop.url | append: '#article' | json }},
        "url": {{ article.url | prepend: shop.url | json }},
        "headline": {{ article.title | strip_html | truncate: 110 | json }},
        "datePublished": {{ article.published_at | date: "%Y-%m-%dT%H:%M:%SZ" | json }},
        "author": { "@type": "Person", "name": {{ article.author | json }} }
      }
    {%- endfor -%}
  ]
}
</script>
